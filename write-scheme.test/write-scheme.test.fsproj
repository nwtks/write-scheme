<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="LiteralTest.fs" />
    <Compile Include="SpecialFormTest.fs" />
    <Compile Include="BindingTest.fs" />
    <Compile Include="ConditionalTest.fs" />
    <Compile Include="LazyTest.fs" />
    <Compile Include="DynamicBindingTest.fs" />
    <Compile Include="ExceptionTest.fs" />
    <Compile Include="QuasiquoteTest.fs" />
    <Compile Include="MacroTest.fs" />
    <Compile Include="RecordTest.fs" />
    <Compile Include="LibraryTest.fs" />
    <Compile Include="CoreTest.fs" />
    <Compile Include="MathTest.fs" />
    <Compile Include="BoolTest.fs" />
    <Compile Include="ListTest.fs" />
    <Compile Include="SymbolTest.fs" />
    <Compile Include="CharTest.fs" />
    <Compile Include="StrTest.fs" />
    <Compile Include="VectorTest.fs" />
    <Compile Include="ByteVectorTest.fs" />
    <Compile Include="ProcedureTest.fs" />
    <Compile Include="DynamicWindTest.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*" />
    <PackageReference Include="FsUnit.xUnit" Version="7.*" />
    <PackageReference Include="xunit.v3" Version="3.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="8.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../write-scheme/write-scheme.fsproj" />
  </ItemGroup>

</Project>
